<?xml version="1.0" encoding="utf-8"?>
<!-- 模组结构参考：docs/mod-structure-reference-zh.md。显示名与许可待维护者确认后替换。 -->
<ModMetaData>
  <packageId>coahuilite.universalsqueaker</packageId>
  <modVersion>0.1.0-dev</modVersion>
  <name>Universal Squeaker</name>
  <author>Coahuilite</author>
  <supportedVersions><li>1.6</li></supportedVersions>
  <!-- FerriteLib is a hard prerequisite: it carries FerriteLib.UiKit.dll, which US compiles against
       and binds to at runtime. RimWorld's modDependencies cannot express a version (ModRequirement
       only parses packageId / alternativePackageIds / displayName), so the API-range assert lives in
       code: FerriteLib.UiKit.Kernel.FerriteLibVersion.Require, called from Mod's constructor. -->
  <modDependencies>
    <li>
      <packageId>coahuilite.ferritelib</packageId>
      <displayName>FerriteLib</displayName>
    </li>
  </modDependencies>
  <loadAfter>
    <li>coahuilite.ferritelib</li>
  </loadAfter>
  <description>Placeholder description for the local fork. Replace before any release.</description>
</ModMetaData>
