<?xml version="1.0" encoding="utf-8"?>
<!-- Structure: docs/mod-structure-reference-zh.md. Version is the numeric tag base; rc1 belongs
     to the release tag/asset name. RimWorld 1.6 and the 1.7 basic-compatibility candidate share the 1.6 payload. -->
<ModMetaData>
  <packageId>coahuilite.universalsqueaker</packageId>
  <modVersion>0.6.0</modVersion>
  <name>Universal Squeaker — B／种族名册版</name>
  <author>Coahuilite</author>
  <supportedVersions>
    <li>1.6</li>
    <li>1.7</li>
  </supportedVersions>
  <!-- FerriteLib is a hard prerequisite: it carries FerriteLib.UiKit.dll, which US compiles against
       and binds to at runtime. RimWorld's modDependencies cannot express a version (ModRequirement
       only parses packageId / alternativePackageIds / displayName), so the API-range assert lives in
       code: FerriteLib.UiKit.Kernel.FerriteLibVersion.Require, called from Mod's constructor. -->
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=2009463077</steamWorkshopUrl>
    </li>
    <li>
      <packageId>coahuilite.ferritelib</packageId>
      <displayName>FerriteLib</displayName>
      <!-- The game logs "needs to have <downloadUrl> and/or <steamWorkshopUrl> specified" without one
           (observed in the 2026-09-14 Player.log). The carrier is public on GitHub. -->
      <downloadUrl>https://github.com/Coahuilite/FerriteLib/releases</downloadUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>coahuilite.ferritelib</li>
  </loadAfter>
  <description>本地原生 UI 比较 B／种族名册版。Voices 目标名册与 Packs 镜头；Tuning 含行为、输出、最终表和预设；System 含外观与入口、诊断及恢复。与 A 共用 packageId 和设置；不可同时安装 A 与 B。rnrnLocal native UI comparison B / Species roster. Voices target roster with a Packs lens; Tuning contains Behaviour, Output, Final table and Presets; System contains Appearance/entry, Diagnostics and Restore. A and B share the packageId and settings. Install only one US variant, alongside the shared FerriteLib and existing prerequisites.</description>
</ModMetaData>