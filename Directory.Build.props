<Project>
  <PropertyGroup>
    <!-- One explicit fixed input shared by production, harnesses and nested builds.
         Never fall back to a stale 0.7 sibling payload. Pure projects need no carrier. -->
    <FerriteLibArtifactFullPath Condition="'$(FerriteLibArtifactPath)' != ''">$([System.IO.Path]::GetFullPath('$(FerriteLibArtifactPath)', '$(MSBuildThisFileDirectory)'))</FerriteLibArtifactFullPath>
  </PropertyGroup>
</Project>
