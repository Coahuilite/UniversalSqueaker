<?xml version="1.0" encoding="utf-8"?>
<!--
  VF1 Ratkin shipped default fallback profile: the 15 production actions mapped to the
  neutral-purpose US_Voice_* defs in VF1_Ratkin_Voices.xml, following the SR reference
  combination (ratkin-native-mapping.json). Crying/Giggling (easter-egg keys) stay absent -
  absent means unset, which is the normal no-sound state, not an error.
  This is pack data consumed by SqueakKernelAdapter.BuildBuiltInSource; the Kernel carries no
  race seed. No other race ships default data here.
  The root element names the FULLY QUALIFIED product type: the standard game Def loader
  resolves XML names through GenTypes by assembly-qualified name (per
  ckpt-20261007/pm-vf1-def-loader.md), so an unqualified custom-type root would not load.
-->
<Defs>
  <UniversalSqueaker.UniversalSqueakerFallbackProfileDef Name="US_FallbackProfile_Ratkin">
    <defName>US_FallbackProfile_Ratkin</defName>
    <raceDefName>Ratkin</raceDefName>
    <profileVersion>1</profileVersion>
    <entries>
      <li><actionKey>us.core/Call</actionKey><soundKey>US_Voice_Chatter</soundKey></li>
      <li><actionKey>us.core/Eat</actionKey><soundKey>US_Voice_Eat</soundKey></li>
      <li><actionKey>us.core/Sleep</actionKey><soundKey>US_Voice_Sleep</soundKey></li>
      <li><actionKey>us.core/Wounded</actionKey><soundKey>US_Voice_Wounded</soundKey></li>
      <li><actionKey>us.core/Select</actionKey><soundKey>US_Voice_Angry</soundKey></li>
      <li><actionKey>us.core/Move</actionKey><soundKey>US_Voice_Chatter</soundKey></li>
      <li><actionKey>us.core/Social</actionKey><soundKey>US_Voice_Chatter</soundKey></li>
      <li><actionKey>us.core/Joy</actionKey><soundKey>US_Voice_Chatter</soundKey></li>
      <li><actionKey>us.core/Death</actionKey><soundKey>US_Voice_Death</soundKey></li>
      <li><actionKey>us.core/Draft</actionKey><soundKey>US_Voice_Angry</soundKey></li>
      <li><actionKey>us.core/Undraft</actionKey><soundKey>US_Voice_Chatter</soundKey></li>
      <li><actionKey>us.core/Attack</actionKey><soundKey>US_Voice_Angry</soundKey></li>
      <li><actionKey>us.core/Work</actionKey><soundKey>US_Voice_Chatter</soundKey></li>
      <li><actionKey>us.core/Equip</actionKey><soundKey>US_Voice_Angry</soundKey></li>
      <li><actionKey>us.core/MentalBreak</actionKey><soundKey>US_Voice_MentalBreak</soundKey></li>
    </entries>
  </UniversalSqueaker.UniversalSqueakerFallbackProfileDef>
</Defs>
