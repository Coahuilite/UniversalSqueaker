<Project>
  <!-- Target-isolated restore graph; empty preserves the original RW1.6 entry and output. -->
  <PropertyGroup Condition="'$(UsRimWorldTarget)' == 'RimWorld17'">
    <BaseIntermediateOutputPath>obj/RimWorld17/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework Condition="'$(UsRimWorldTarget)' == ''">net472</TargetFramework>
    <TargetFramework Condition="'$(UsRimWorldTarget)' == 'RimWorld17'">net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>UniversalSqueaker</AssemblyName>
    <RootNamespace>UniversalSqueaker</RootNamespace>
    <Version>0.6.0</Version>
    <!-- VersionPrefix must stay a bare numeric prefix and must never point at a suffixed Version:
         $(VersionPrefix) is what AssemblyVersion/FileVersion below are built from, so a suffix there
         produces an illegal assembly version. The identity axis moves with the release (<Version>,
         <VersionPrefix> and About.xml <modVersion> together); the suffix stays in the tag and the
         artifact name only, never in the identity axis. -->
    <VersionPrefix>0.6.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\dist\build\$(Configuration)\$(UsRimWorldTarget)\</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 本地离线环境：禁用 NuGet 漏洞审计，避免 NU1900 在无网时被提升为错误。 -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>$(DefineConstants);US_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与本地 NuGet 缓存/SR 参考项目解析结果一致的固定版本；离线可还原。 -->
    <PackageReference Condition="'$(UsRimWorldTarget)' == ''" Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- FerriteLib is its own prerequisite mod (coahuilite.ferritelib). US compiles against the
         explicitly selected fixed package and ships nothing of it: Private=false keeps the DLL out of
         1.6/Assemblies, so the mod package cannot grow a second carrier copy. A same-version package
         feed was measured and rejected: NuGet drops build metadata from the cache identity, so a
         dev-plus-sha version still lands in one stale lib/0.1.0-dev folder, and these gates restore
         once and then run with restore disabled, so a floating version would go green against the
         previously resolved graph. dotnet pack still works in that repo for when there is a remote
         or a third-party consumer. -->
    <Reference Include="FerriteLib.UiKit">
      <HintPath>$(FerriteLibArtifactFullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Native1.7 uses the exact installed/snapshotted four-reference set, as in 48b8fab.
       These are compile inputs only: no game or FL DLL enters the US package. -->
  <ItemGroup Condition="'$(UsRimWorldTarget)' == 'RimWorld17'">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorld17Dir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorld17Dir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RimWorld"><HintPath>$(RimWorld17Dir)/RimWorld.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorld17Dir)/Waylith.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireNativeTargetInputs" BeforeTargets="ResolveReferences">
    <Error Condition="'$(UsRimWorldTarget)' != '' And '$(UsRimWorldTarget)' != 'RimWorld17'" Text="UsRimWorldTarget must be empty (RW1.6/net472) or RimWorld17 (RW1.7/net10)." />
    <Error Condition="'$(UsRimWorldTarget)' == 'RimWorld17' And (!Exists('$(RimWorld17Dir)/Assembly-CSharp.dll') Or !Exists('$(RimWorld17Dir)/UnityStubs.dll') Or !Exists('$(RimWorld17Dir)/RimWorld.dll') Or !Exists('$(RimWorld17Dir)/Waylith.dll'))" Text="Select the four exact native1.7 compiler references with RimWorld17Dir. No1.6 fallback or game download is used." />
  </Target>
  <!-- Include the actual compiler reference in the assembly identity. A changed hash changes this
       generated source, so an incremental build cannot retain a receipt for a different carrier. -->
  <Target Name="RequireFerriteLibSelection" BeforeTargets="ResolveReferences">
    <Error Condition="'$(FerriteLibArtifactPath)' == ''" Text="Select a fixed FerriteLib 0.9 package matching the selected game target with -p:FerriteLibArtifactPath; no implicit carrier is used." />
  </Target>
  <Target Name="RecordFerriteLibReference" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <PropertyGroup>
      <_SelectedFerriteLibPath>$([System.IO.Path]::GetFullPath('$(FerriteLibArtifactFullPath)'))</_SelectedFerriteLibPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(FerriteLibArtifactFullPath)')" Text="Selected FerriteLib artifact is missing: $(FerriteLibArtifactFullPath)" />
    <ItemGroup>
      <_FerriteLibReference Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'FerriteLib.UiKit'" />
    </ItemGroup>
    <Error Condition="'@(_FerriteLibReference->Count())' != '1'" Text="Expected exactly one resolved FerriteLib compiler reference." />
    <Error Condition="'@(_FerriteLibReference->'%(FullPath)')' != '$(_SelectedFerriteLibPath)'" Text="Resolved FerriteLib reference differs from the selected artifact." />
    <GetFileHash Files="@(_FerriteLibReference)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_FerriteLibHash" />
    </GetFileHash>
    <ItemGroup>
      <_FerriteLibIdentity Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>FerriteLib.SHA256</_Parameter1>
        <_Parameter2>%(_FerriteLibHash.FileHash)</_Parameter2>
      </_FerriteLibIdentity>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(_FerriteLibIdentity)" Language="C#" OutputFile="$(IntermediateOutputPath)FerriteLibIdentity.g.cs">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
      <Output TaskParameter="OutputFile" ItemName="FileWrites" />
    </WriteCodeFragment>
  </Target>

  <ItemGroup>
    <!-- Schema=2 is the only shipped page vocabulary: settings page, camera-indicator overlay and the
         SA1.3 Remix confirmation dialog, and diagnostics screen mark. All four are read through Assembly.GetManifestResourceStream
         by their kernel-side owner (the two settings hosts, then the per-window RemixConfirmationFlow). -->
    <EmbeddedResource Include="UI\Layout.Schema2.xml" />
    <None Remove="UI\Layout.Schema2.xml" />
    <EmbeddedResource Include="UI\Layout.Overlay.Schema2.xml" />
    <EmbeddedResource Include="UI\Layout.DiagnosticsMark.Schema2.xml" />
    <None Remove="UI\Layout.Overlay.Schema2.xml" />
    <EmbeddedResource Include="UI\Layout.RemixConfirm.Schema2.xml" />
    <None Remove="UI\Layout.RemixConfirm.Schema2.xml" />
  </ItemGroup>

  <ItemGroup><EmbeddedResource Include="Themes/Palettes.xml" LogicalName="UniversalSqueaker.Themes.Palettes.xml" /></ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
