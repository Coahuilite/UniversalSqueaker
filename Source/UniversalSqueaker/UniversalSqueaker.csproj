<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>UniversalSqueaker</AssemblyName>
    <RootNamespace>UniversalSqueaker</RootNamespace>
    <Version>0.4.0</Version>
    <!-- VersionPrefix must stay a bare numeric prefix and must never point at a suffixed Version:
         $(VersionPrefix) is what AssemblyVersion/FileVersion below are built from, so a suffix there
         produces an illegal assembly version. The identity axis moves with the release (<Version>,
         <VersionPrefix> and About.xml <modVersion> together); the suffix stays in the tag and the
         artifact name only, never in the identity axis. -->
    <VersionPrefix>0.4.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 本地离线环境：禁用 NuGet 漏洞审计，避免 NU1900 在无网时被提升为错误。 -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>$(DefineConstants);US_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与本地 NuGet 缓存/SR 参考项目解析结果一致的固定版本；离线可还原。 -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- FerriteLib is its own prerequisite mod (coahuilite.ferritelib). US compiles against the
         sibling repo's built payload and ships nothing of it: Private=false keeps the DLL out of
         1.6/Assemblies, so the mod package cannot grow a second carrier copy. A same-version package
         feed was measured and rejected: NuGet drops build metadata from the cache identity, so a
         dev-plus-sha version still lands in one stale lib/0.1.0-dev folder, and these gates restore
         once and then run with restore disabled, so a floating version would go green against the
         previously resolved graph. dotnet pack still works in that repo for when there is a remote
         or a third-party consumer. -->
    <Reference Include="FerriteLib.UiKit">
      <HintPath>..\..\..\ferritelib\1.6\Assemblies\FerriteLib.UiKit.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Schema=2 is the only shipped page manifest: settings page plus the camera-indicator overlay.
         Both are read through Assembly.GetManifestResourceStream by their kernel Host. -->
    <EmbeddedResource Include="UI\Layout.Schema2.xml" />
    <None Remove="UI\Layout.Schema2.xml" />
    <EmbeddedResource Include="UI\Layout.Overlay.Schema2.xml" />
    <None Remove="UI\Layout.Overlay.Schema2.xml" />
  </ItemGroup>

</Project>
