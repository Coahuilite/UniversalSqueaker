<?xml version="1.0" encoding="utf-8"?>
<UiPage Schema="2" Source="coahuilite.universalsqueaker">
  <!-- Spec 1.4 row/density axis. The two tiers are authored here, not in code, because the library's
       density axis is the style document: RowHeight 24 is the regular row, 20 the dense one. The hit band
       stays 24 either way - hit geometry is not a density token - and so do the chrome heights that are
       not data rows (footer 28, overlay-root 26): those must not follow row density. -->
  <Styles Schema="1" Density="regular">
    <Density Name="regular">
      <Metric Token="RowHeight" Value="24" />
    </Density>
    <Density Name="dense">
      <Metric Token="RowHeight" Value="20" />
    </Density>
  </Styles>
  <Column Id="page-root" Gap="8" Padding="12">
    <Row Id="header-band" Padding="0" Gap="6">
      <Widget Id="page-title" Kind="us/page-title" />
      <Widget Id="help-toggle" Kind="input/button" TextKey="US.Help.Drawer.Toggle"
              ActionBind="toggle-help-drawer" Width="128" Height="26"
              AlignY="Middle" HelpKey="us/page-title/help-drawer" />
    </Row>
    <!-- Fixed page-header band (S3-2a added it, S3-2b moved the title in). Both the title and the Help
         toggle live HERE, outside every scroll: the shell chrome has no action slot (FL-18 will not come),
         and a header inside content-scroll scrolled away with the workspace.
         It is a ROW and not an Overlay on purpose: a Row hands the title "whatever the fixed switch
         leaves" with no reserved width spelled in code, and a Row's main axis already has an owner, so the
         switch is right-aligned by being the last fixed-width child rather than by AlignX (which the engine
         refuses on a Row child). With an Overlay the title would Stretch across the full inner width and
         the caption would paint UNDER the switch, because the widget no longer reserves the switch's space
         and a hand-written reservation is exactly the threshold this project bans.
         The engine claims a hovered element's HelpKey for any kind, which is why the toggle's catalog item
         (us/page-title/help-drawer) is declared here while the page-title widget no longer draws it.
         Exactly ONE element in this manifest may carry the help-toggle action binding (this comment
         deliberately does not spell the literal: the drawer lane counts its occurrences in this file).
         The page-title widget carried a second, hand-drawn switch until this step, so "the page has one
         Help switch" is asserted by the frame lane and the drawer lane rather than assumed. -->
    <!-- Responsive footer for the drawer. The closed window is 600 wide (WindowChromeLayout), i.e.
         536 inner here, and Breakpoint 500 keeps that a two-column Row in BOTH drawer states - the
         same Row at 736/1024 and the shipped three columns once the drawer opens; only 480/320 fall
         below it and the Row resolves to a Column, stacking nav/centre/help as full-width Fill
         containers instead of three squeezed columns. The help column itself is toggled DECLARATIVELY
         by the engine-level VisibleKey attribute bound to this page's own help-open value binding, never
         by Tab: the element stays in the definition so its node and scroll position survive a close/open
         (a root-list VARIANT was the pre-0.5 mechanism, and 0.6 releases a removed element's node with
         its scroll position). -->
    <!-- Fill="true" is what makes this row the page's flex slot (it is what §2 always drew). Without it no
         child of page-root yields, so ANY band's declared height would be ADDED to the page instead of taken
         out of the body - measured at the minimum logical resolution: footer bottom 667 against a 530 page.
         With it whichever slot is arranged - this row, or the narrow help band that replaces it - absorbs
         what the fixed header and footer leave, so the footer stays in by construction.

         VisibleKey="body-visible" is the other half of that exclusivity (shape fixed 2026-09-21b): on a
         screen that cannot host the widened window the OPEN drawer does not share the page with the body,
         it REPLACES it. The host derives body-visible as the negation of help-open-narrow, so the body is
         not ARRANGED while the band is, and the band is then page-root's ONLY flexible fill child. Hiding
         rather than removing is the whole point: the element stays in the definition, so its node, its
         sub-tree and every scroll position survive the swap (see the help-band comment below). -->
    <Row Id="body-row" Fill="true" Gap="12" Padding="0" Breakpoint="500" Narrow="Column"
         VisibleKey="body-visible">
      <Column Id="nav-column" Width="200" Padding="0">
        <Widget Id="nav" Kind="us/nav" />
      </Column>
      <Scroll Id="content-scroll" Fill="true" Gap="8" Padding="0">
        <Widget Id="banner" Kind="chrome/banner" Bind="banner-text" />
        <Widget Id="mode-row" Kind="us/mode-row" Bind="mode" Tab="Overview" />
        <!-- S4-1: the first three Overview cards are DECLARATIVE. The three composites that used to
             own them (us/global-volume, us/basic-tuning, us/camera-indicator) were dissolved here and
             retired in the same change, so the Registrar's us/* kind set shrank 18 -> 15.

             Card chrome is the engine's Section container with the same explicit geometry the checklist
             card already declares (Padding 12 + header 26 + Gap 6 reproduces UsCardLayout.MeasureBody).
             Section help sits on the section/header WIDGET, never on the container: HelpKey is refused on
             a container because only a widget is a hit surface.

             Rows are [label | control] Rows. The label is text/wrapped, which measures its own wrapped
             band; it deliberately carries no Width - a Row already hands a sized child's leftover to the
             unsized one, exactly the arrangement the fixed header band uses - and no Fill, which the
             attribute schema refuses on a widget. The checkbox is input/checkbox with Width 24 Height 30:
             30 is not a row constant, it is what makes the atom's own box geometry
             (side = max(8, height - theme.Geometry.Padding * 2), Padding 6) land on the shipped 18px
             visual box the composite drew.

             Each checkbox carries Bind only, never ActionBind: the atom writes the INVERSE of the bool it
             read through the value binding's own setter, so the value binding IS the toggle and the seven
             toggle-* action bindings the composites needed are retired with them. That is also why the row
             hit band the composites drew no longer exists - the checkbox band is the row's only hit
             surface (the same delta the checklist migration recorded).

             The child of the eat-precision pair is gated by the engine's VisibleKey reading the parent's
             own bool binding, which is the declarative form of the rule the composite enforced in C#. -->
        <Section Id="global-volume" Tab="Overview" Padding="12" Gap="6">
          <Widget Id="global-volume-header" Kind="section/header" TitleKey="US.Section.OutputLevel" Height="26" HelpKey="us/global-volume" />
          <Row Id="global-volume-top" Gap="8" Padding="0">
            <Widget Id="global-volume-caption" Kind="text/wrapped" Bind="global-volume-caption" Emphasis="Muted" />
            <Widget Id="global-volume-number" Kind="input/number-field" Bind="global-volume-percent" Min="0" Max="100" Format="0" Width="64" Height="20" AlignY="Top" HelpKey="us/global-volume/number" />
          </Row>
          <Widget Id="global-volume-slider" Kind="input/slider" Bind="global-volume" Min="0" Max="1" Height="20" HelpKey="us/global-volume/slider" />
        </Section>
        <Section Id="basic-tuning" Tab="Overview" Padding="12" Gap="6">
          <Widget Id="basic-tuning-header" Kind="section/header" TitleKey="US.Section.PlaybackBehaviour" Height="26" HelpKey="us/basic-tuning" />
          <Column Id="basic-tuning-body" Gap="2" Padding="0">
            <Row Id="basic-egg-row" Gap="8" Padding="0">
              <Column Id="basic-egg-text" Gap="1" Padding="0">
                <Widget Id="basic-egg-label" Kind="text/wrapped" TextKey="US.Tuning.EasterEggs" HelpKey="us/basic-tuning/egg" />
                <Widget Id="basic-egg-state-on" Kind="text/wrapped" TextKey="US.Tuning.EasterEggs.On" Emphasis="Muted" VisibleKey="easter-egg-on" />
                <Widget Id="basic-egg-state-off" Kind="text/wrapped" TextKey="US.Tuning.EasterEggs.Off" Emphasis="Muted" VisibleKey="easter-egg-off" />
              </Column>
              <Widget Id="basic-egg-check" Kind="input/checkbox" Bind="allow-eggs" Width="24" Height="30" AlignY="Middle" HelpKey="us/basic-tuning/egg" />
            </Row>
            <Widget Id="basic-egg-rule" Kind="chrome/rule" />
            <Row Id="basic-cooldown-row" Gap="8" Padding="0">
              <Widget Id="basic-cooldown-label" Kind="text/wrapped" TextKey="US.Tuning.ScaleCooldown" HelpKey="us/basic-tuning/scale-cooldown" />
              <Widget Id="basic-cooldown-check" Kind="input/checkbox" Bind="scale-cooldown" Width="24" Height="30" AlignY="Middle" HelpKey="us/basic-tuning/scale-cooldown" />
            </Row>
            <Widget Id="basic-cooldown-rule" Kind="chrome/rule" />
            <Row Id="basic-talking-row" Gap="8" Padding="0">
              <Widget Id="basic-talking-label" Kind="text/wrapped" TextKey="US.Tuning.ScaleTalking" HelpKey="us/basic-tuning/scale-talking" />
              <Widget Id="basic-talking-check" Kind="input/checkbox" Bind="scale-talking" Width="24" Height="30" AlignY="Middle" HelpKey="us/basic-tuning/scale-talking" />
            </Row>
            <Widget Id="basic-talking-rule" Kind="chrome/rule" />
            <Row Id="basic-population-row" Gap="8" Padding="0">
              <Widget Id="basic-population-label" Kind="text/wrapped" TextKey="US.Tuning.ScalePopulation" HelpKey="us/basic-tuning/scale-population" />
              <Widget Id="basic-population-check" Kind="input/checkbox" Bind="scale-population" Width="24" Height="30" AlignY="Middle" HelpKey="us/basic-tuning/scale-population" />
            </Row>
            <Widget Id="basic-population-rule" Kind="chrome/rule" />
            <Row Id="basic-eat-row" Gap="8" Padding="0">
              <Widget Id="basic-eat-label" Kind="text/wrapped" TextKey="US.Tuning.EatPrecision" HelpKey="us/basic-tuning/eat-precision" />
              <Widget Id="basic-eat-check" Kind="input/checkbox" Bind="eat-precision" Width="24" Height="30" AlignY="Middle" HelpKey="us/basic-tuning/eat-precision" />
            </Row>
            <Widget Id="basic-eat-rule" Kind="chrome/rule" />
            <Row Id="basic-eat-child-row" Gap="8" Padding="0" VisibleKey="eat-precision">
              <Widget Id="basic-eat-child-label" Kind="text/wrapped" TextKey="US.Tuning.EatPrecision.IncludeDrugs" HelpKey="us/basic-tuning/eat-precision-include-drugs" />
              <Widget Id="basic-eat-child-check" Kind="input/checkbox" Bind="eat-precision-include-drugs" Width="24" Height="30" AlignY="Middle" HelpKey="us/basic-tuning/eat-precision-include-drugs" />
            </Row>
          </Column>
        </Section>
        <Widget Id="timing" Kind="us/timing" TitleKey="US.Section.TriggerTiming" HelpKey="us/timing" Tab="Overview" />
        <Section Id="camera-indicator" Tab="Overview" Padding="12" Gap="6">
          <Widget Id="camera-indicator-header" Kind="section/header" TitleKey="US.Section.InWorldIndicator" Height="26" HelpKey="us/camera-indicator" />
          <Row Id="camera-indicator-row" Gap="8" Padding="0">
            <Widget Id="camera-indicator-label" Kind="text/wrapped" TextKey="US.Tuning.CameraIndicator" HelpKey="us/camera-indicator/toggle" />
            <Widget Id="camera-indicator-check" Kind="input/checkbox" Bind="camera-indicator" Width="24" Height="30" AlignY="Middle" HelpKey="us/camera-indicator/toggle" />
          </Row>
        </Section>
        <Widget Id="diagnostics" Kind="us/diagnostics" TitleKey="US.Section.Diagnostics" HelpKey="us/diagnostics" Tab="Overview" />
        <Widget Id="attenuation-editor" Kind="us/attenuation-editor" TitleKey="US.Section.DistanceAttenuation" HelpKey="us/attenuation-editor" Tab="Distance" />
        <Widget Id="filter-bar" Kind="us/filter-bar" TitleKey="US.Section.FilterDomains" HelpKey="us/filter-bar" Tab="Packs" />
        <Widget Id="race-layer" Kind="us/race-layer" TitleKey="US.Section.RaceDomain" HelpKey="us/race-layer" Tab="Packs" />
        <Widget Id="xenotype-layer" Kind="us/xenotype-layer" TitleKey="US.Section.XenotypeDomain" HelpKey="us/xenotype-layer" Tab="Packs" />
        <!-- Step A/B of the checklist migration: the card is the engine's Section container, carrying the
             same explicit geometry every other container on this page already declares (CP-0). It is gated
             by the engine's own Tab attribute - the container vocabulary gained it as a coherence fix, so
             the one-bool VisibleKey shim this card used while the container contract lacked the name is
             deleted. A Tab-gated container takes its whole subtree with it, and a hidden container keeps its
             node and state, so switching workspaces churns no identity. The section help sits on a WIDGET
             (section/header) because HelpKey is refused on containers. Padding 12 + header 26 + Gap 6
             reproduces UsCardLayout.MeasureBody (12 + 26 + 6 + body + 12) exactly.

             The card's body is declarative from step B: the retained status-band composite
             (us/voice-pack-checklist: the three role-mapped domain banners and the orphan band - the G5
             citation), then a search field, a Repeat of pack rows and two empty states, all gated by
             VisibleKey bools. The two presentations are mutually exclusive, the same shape the diagnostics
             nav column uses. The orphan band now draws ABOVE the list rather than below it: it is a band
             about the list that follows, and a widget element cannot straddle manifest siblings. -->
        <Section Id="checklist-card" Tab="Packs" Padding="12" Gap="6">
          <Widget Id="checklist-header" Kind="section/header" TitleKey="US.Section.ChooseVoicePacks" Height="26" HelpKey="us/voice-pack-checklist" />
          <Widget Id="checklist" Kind="us/voice-pack-checklist" TitleHidden="true" />
          <Column Id="checklist-list" VisibleKey="checklist-has-domain" Gap="6" Padding="0">
            <Widget Id="checklist-search" Kind="input/text-field" Bind="search-text" PlaceholderKey="US.Packs.Checklist.SearchPlaceholder" Height="24" HelpKey="us/voice-pack-checklist/search" />
            <Repeat Id="checklist-rows" Items="checklist-pack-keys" Template="checklist-row" Gap="2" />
            <Widget Id="checklist-empty-domain" Kind="state/empty" TextKey="US.Packs.Checklist.EmptyDomain" VisibleKey="checklist-empty-domain" />
            <Widget Id="checklist-empty-search" Kind="state/empty" TextKey="US.Packs.Checklist.EmptySearch" VisibleKey="checklist-empty-search" />
          </Column>
          <Widget Id="checklist-empty-nodomain" Kind="state/empty" TextKey="US.Packs.Checklist.NoDomains" VisibleKey="checklist-empty-nodomain" />
        </Section>
        <Widget Id="scope-tree" Kind="us/scope-tree" TitleKey="US.Section.LayeredTuning" HelpKey="us/scope-tree" Tab="Tuning" />
        <Widget Id="preset-list" Kind="us/preset-list" TitleKey="US.Section.DefBaselines" HelpKey="us/preset-list" Tab="Presets" />
      </Scroll>
      <Scroll Id="help-scroll" Width="320" MinWidth="260" Fill="true" Padding="0" VisibleKey="help-open-wide">
        <Widget Id="help-panel" Kind="us/help-panel" />
      </Scroll>
    </Row>
    <!-- Narrow-screen help (乙1, decided 2026-09-21; the shape was re-cut 2026-09-21b after the
         maintainer's 1024x768 walkthrough). When the logical screen cannot host the widened window the
         drawer does NOT take a third column and does NOT share the room with the body: the same help panel
         REPLACES the body as a full-width band between the header and the footer, and the body row is not
         arranged (its own VisibleKey="body-visible"). Two mutually exclusive presentations and ONE player
         intent: help-open stays the only value the toggle writes, and the host derives help-open-wide /
         help-open-narrow from it and the screen (WindowChromeLayout.DrawerWidensTheWindow).

         Fill="true" with NO Height is what makes the replacement exact rather than approximate. With the
         body out of the flow this band is page-root's ONLY flexible fill child, so it is handed the whole
         leftover BY CONSTRUCTION and the footer cannot leave the page - no number is written here at all.
         Measured at the game's minimum logical resolution (1024x768 -> a 1024x600 window, so a 960x530
         page): 506 inner - header ~60 - footer ~26 - 2 x Gap 8 = ~404 for the band, against the largest
         natural content floor anywhere on the page (us/nav = 271). So the help is readable (the panel's
         own measured band is ~130 in the stub) AND the text on the page has more room than it needs.

         Why Height="280" is gone, and it is not coming back. That attribute was a reserved band, the only
         expression the vocabulary allowed - a container has no MinHeight/MaxHeight (width has
         MinWidth/MaxWidth, height does not), no fill weight, and no HeightKey - and it cannot work at this
         resolution: 530 - 60 (header) - 26 (footer) - 16 (gaps) leaves 428 for body + band while the body's
         own content floor is 271, so the band can never exceed ~157 and a 280 band leaves the body ~148 and
         its content overflows ~123px into the band (the maintainer's 1024x768 walkthrough). "A band more
         than half the content area" and "the content fits" cannot both hold at 1024x768: it was a SHAPE
         problem, and the shape is fixed by EXCLUSION rather than by another number. A Height attribute here
         would also re-break it mechanically: IsFlexibleFill refuses a Fill child with a fixed Height, so the
         band would leave the flow and the footer would be pushed out (the earlier Fill attempt measured a
         page natural height of 660.7 against this 530 viewport). It stays a Scroll, so a longer real-font
         panel scrolls instead of being clipped. -->
    <Scroll Id="help-band" Fill="true" Padding="0" VisibleKey="help-open-narrow">
      <Widget Id="help-panel-narrow" Kind="us/help-panel" />
    </Scroll>
    <!-- Footer band (S3-3): the same structural slot as the header, so the frame's three bands are all
         declared. It carries NO Height, for the reason its child never did - a pinned band overrides a
         wrap-aware measure (the in-game log kept reporting "footer needs 33px has 28px" while the
         attribute was pinning 28). §2's fragment wrote Height="26"; that is the same pin and is NOT
         implemented. The band's CONTENT is still the us/footer composite: atomising it into a status and
         a build text is S4's migration, not this slice's. -->
    <Overlay Id="footer-band" Padding="0">
      <Widget Id="footer" Kind="us/footer" />
    </Overlay>
  </Column>
  <!-- Per-item subtrees a <Repeat> materializes, keyed by the Id a Template="..." names. Bind/VisibleKey/
       ActionBind inside a template are qualified per item by the engine (<Items>.<itemKey>.<declaredKey>),
       which is what lets one declared subtree draw every row; HelpKey is deliberately NOT qualified, so
       every row claims the same catalog entry exactly as the hand-drawn row loop did. -->
  <Templates>
    <Row Id="checklist-row" Gap="4" Padding="0">
      <Column Id="checklist-row-text" Gap="2" Padding="0">
        <Widget Id="checklist-row-label" Kind="text/wrapped" Bind="label" HelpKey="us/voice-pack-checklist/row" />
        <Widget Id="checklist-row-meta" Kind="text/wrapped" Bind="meta" Emphasis="Muted" HelpKey="us/voice-pack-checklist/row" />
        <Widget Id="checklist-row-coverage" Kind="text/wrapped" Bind="coverage" Emphasis="Muted" HelpKey="us/voice-pack-checklist/row" />
      </Column>
      <Widget Id="checklist-row-check" Kind="input/checkbox" Bind="enabled" Width="24" Height="30" AlignY="Middle" HelpKey="us/voice-pack-checklist/row" />
    </Row>
  </Templates>
</UiPage>
