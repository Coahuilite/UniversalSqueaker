  <Widget Id="banner" Kind="chrome/banner" Bind="BannerText" Font="Tiny" />
  <Widget Id="mode-row" Kind="input/mode-row" Bind="Mode" EmitName="SetMode"
          Title1="Off" Description1="Disable VoicePack audio routing." Value1="Off"
