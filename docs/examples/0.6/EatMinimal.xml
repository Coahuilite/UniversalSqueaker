    <defName>US_ExampleEatMinimal</defName>
    <declaration>
      <race>Ratkin</race>
      <entries>
        <li><key>eat</key><action>us.core/Eat</action><sound>Click</sound></li>
      </entries>
    </declaration>
  </UniversalSqueaker.UsVoicePackDef>
</Defs>
