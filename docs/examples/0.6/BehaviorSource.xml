<Defs>
  <!-- Optional author behavior, independent of this pack's audio switch. Exact-domain selection is explicit. -->
  <UniversalSqueaker.UsBehaviorSourceDef>
    <defName>US_ExampleBehavior</defName>
    <declaration family="Pawn" namespace="" target="Ratkin" child="" semantics="1">
      <action key="Work" enabled="false" hardIntervalTicks="0" talkingEnabled="false" volume="0" />
      <action key="Select" enabled="true" scope="AnyOccurrence" requires="us.core/Responsive" />
    </declaration>
  </UniversalSqueaker.UsBehaviorSourceDef>
  <UniversalSqueaker.UsActionDef>
    <defName>US_ExampleDrugChewing</defName>
    <declaration>
      <key>example/DrugChewing</key><baseAction>us.core/Eat</baseAction>
      <condition><all><ref>us.core/EatChewing</ref><ref>us.core/EatDrug</ref></all></condition>
    </declaration>
  </UniversalSqueaker.UsActionDef>
  <UniversalSqueaker.UsVoicePackDef>
    <defName>US_ExampleDrugAudio</defName>
    <declaration><race>Ratkin</race><entries>
      <li><key>drug-chew</key><action>example/DrugChewing</action><sound>US_RatkinExp_Eat</sound></li>
    </entries></declaration>
  </UniversalSqueaker.UsVoicePackDef>
</Defs>
