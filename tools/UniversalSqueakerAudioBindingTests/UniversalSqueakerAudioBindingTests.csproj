<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SelectFixtureTarget)' == 'MissingInternal'">
    <DefineConstants>$(DefineConstants);US_FIXTURE_SELECT_MISSING_INTERNAL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>$(DefineConstants);US_DEV</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SelectFixtureTarget)' == 'MissingFeedback'">
    <DefineConstants>$(DefineConstants);US_FIXTURE_SELECT_MISSING_FEEDBACK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EatFixtureTarget)' == 'MissingChew'">
    <DefineConstants>$(DefineConstants);US_FIXTURE_EAT_MISSING_CHEW</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DcFixtureTarget)' == 'MissingWoundedAndMeleeMarker'">
    <DefineConstants>$(DefineConstants);US_FIXTURE_DC_MISSING_WOUNDED;US_FIXTURE_DC_MISSING_MELEE_MARKER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
