<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Assembly-CSharp</AssemblyName>
    <RootNamespace>Verse</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\stubs-verse-ext\</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <!-- The frozen renderer stubs are reused UNCHANGED (their own csprojs build in place,
         exactly like the host harness does); only the VERSE half is this folder's extended
         copy. The extension output is a separate assembly path - the frozen snapshot's
         bin/stubs/verse bytes are never produced or touched by this project. -->
    <ProjectReference Include="..\..\..\FerriteLib.Stubs\Stubs\UnityEngineStub\UnityEngineStub.csproj" />
    <ProjectReference Include="..\..\..\FerriteLib.Stubs\Stubs\UnityEngineImGuiStub\UnityEngineImGuiStub.csproj" />
  </ItemGroup>

</Project>
