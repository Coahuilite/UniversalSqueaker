<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>UniversalSqueakerUiLogicTests</AssemblyName>
    <RootNamespace>UniversalSqueaker.UiLogicTests</RootNamespace>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>0.0.0+us-ui-logic</InformationalVersion>
    <!-- 本地离线环境：禁用 NuGet 漏洞审计，避免无网 NU1900 噪声。 -->
    <NuGetAudit>false</NuGetAudit>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- 零 Verse 门：链接 UI 纯逻辑文件；任一引用 Verse/Unity/RimWorld 即编译失败。 -->
  <ItemGroup>
    <Compile Include="../../Source/UniversalSqueaker/UI/Model/ActionPresentations.cs" Link="ActionPresentations.cs" />
    <Compile Include="../../Source/UniversalSqueaker/Core/**/*.cs" Link="Production/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\VoicePacksFilters.cs" Link="VoicePacksFilters.cs" />
    <!-- CORRECTIONS-R1 topic 1: the board projection is plain data logic - compiled here so the
         full state matrix runs with real plain inputs in the zero-game harness. -->
    <Compile Include="..\..\Source\UniversalSqueaker\Catalog\UsDefinitionIdentity.cs" Link="UsDefinitionIdentity.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Model\UsBoardBrowsePolicy.cs" Link="UsBoardBrowsePolicy.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Model\RaceBoardView.cs" Link="RaceBoardView.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Model\RaceBoardProjection.cs" Link="RaceBoardProjection.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\Models\SqueakVoicePackDomain.cs" Link="SqueakVoicePackDomain.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\AttenuationMath.cs" Link="AttenuationMath.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\ActionScopeRules.cs" Link="ActionScopeRules.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\UsCardLayout.cs" Link="UsCardLayout.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\UsFilterBarLayout.cs" Link="UsFilterBarLayout.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\WindowChromeLayout.cs" Link="WindowChromeLayout.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Help\UsHelpCatalog.cs" Link="UsHelpCatalog.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Help\UsHelpPanelLogic.cs" Link="UsHelpPanelLogic.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Diagnostics\UsDiagnosticsProjection.cs" Link="UsDiagnosticsProjection.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\Diagnostics\SqueakDiagnosticsSessionModel.cs" Link="SqueakDiagnosticsSessionModel.cs" />
  </ItemGroup>

</Project>
