<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>UniversalSqueakerUiLogicTests</AssemblyName>
    <RootNamespace>UniversalSqueaker.UiLogicTests</RootNamespace>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>0.0.0+us-ui-logic</InformationalVersion>
    <!-- 本地离线环境：禁用 NuGet 漏洞审计，避免无网 NU1900 噪声。 -->
    <NuGetAudit>false</NuGetAudit>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- 零 Verse 门：链接 UI 纯逻辑文件；任一引用 Verse/Unity/RimWorld 即编译失败。 -->
  <ItemGroup>
    <Compile Include="..\..\Source\UniversalSqueaker\Kernel\SqueakActionDomain.cs" Link="SqueakActionDomain.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\Pure\SqueakActionPlan.cs" Link="SqueakActionPlan.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\VoicePacksFilters.cs" Link="VoicePacksFilters.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\DistancePreview.cs" Link="DistancePreview.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\UiLayoutTier.cs" Link="UiLayoutTier.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\AttenuationMath.cs" Link="AttenuationMath.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\ITextMetrics.cs" Link="ITextMetrics.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\VoicePacksLayout.cs" Link="VoicePacksLayout.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\ActionScopeRules.cs" Link="ActionScopeRules.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Layout\UsCardLayout.cs" Link="UsCardLayout.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Help\UsHelpCatalog.cs" Link="UsHelpCatalog.cs" />
    <Compile Include="..\..\Source\UniversalSqueaker\UI\Help\UsHelpPanelLogic.cs" Link="UsHelpPanelLogic.cs" />
  </ItemGroup>

</Project>
