<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SqueakyKernelCharacterization</AssemblyName>
    <RootNamespace>SqueakyRatkin.KernelCharacterization</RootNamespace>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>0.0.0+kernel</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>$(DefineConstants);SQUEAKY_DEV</DefineConstants>
  </PropertyGroup>

  <!-- 纯度门：内核编译集 = Kernel/*.cs（零根文件依赖，US 拆分迁移清单）。
       另链接漏斗纯文件（执行层纯逻辑，SqueakActionPlan/SqueakTimingModel）：链接只为纯度门，
       不属于内核编译集；任一引用 Verse/Unity/RimWorld 即编译失败（决策 §2.3/§3.2）。 -->
  <ItemGroup>
    <Compile Include="..\..\Kernel\*.cs" Link="Kernel\%(Filename)%(Extension)" />
    <Compile Include="..\..\Pure\SqueakActionPlan.cs" Link="Linked\SqueakActionPlan.cs" />
    <Compile Include="..\..\Pure\SqueakTimingModel.cs" Link="Linked\SqueakTimingModel.cs" />
  </ItemGroup>

</Project>

