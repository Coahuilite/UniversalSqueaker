<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>UniversalSqueakerKernelHostTests</AssemblyName>
    <RootNamespace>UniversalSqueaker.KernelHostTests</RootNamespace>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>0.0.0+us-kernel-host</InformationalVersion>
    <!-- 本地离线环境：禁用 NuGet 漏洞审计，避免无网 NU1900 噪声。 -->
    <NuGetAudit>false</NuGetAudit>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Current 0.8 source-identified platform doubles; the archived 0.7 freeze is unchanged.
         Build only this consumer's independent dist output, never the producer checkout. -->
    <FerriteLibHarness Condition="'$(FerriteLibHarness)' == ''">$(MSBuildProjectDirectory)\..\FerriteLib08.Stubs</FerriteLibHarness>
    <FerriteLibStubOutputRoot Condition="'$(FerriteLibStubOutputRoot)' == ''">$(MSBuildProjectDirectory)\..\..\dist\fl08-migration-a001\stubs\$(Configuration)\</FerriteLibStubOutputRoot>
    <FerriteLibStubObjRoot Condition="'$(FerriteLibStubObjRoot)' == ''">$(MSBuildProjectDirectory)\..\..\dist\fl08-migration-a001\stub-obj\</FerriteLibStubObjRoot>
    <UsProductArtifactPath Condition="'$(UsProductArtifactPath)' == ''">$(MSBuildProjectDirectory)\..\..\dist\build\$(Configuration)\UniversalSqueaker.dll</UsProductArtifactPath>
    <UsRestoreArgument Condition="'$(UsVerificationNoRestore)' == 'true'">--no-restore</UsRestoreArgument>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>$(DefineConstants);US_DEV</DefineConstants>
  </PropertyGroup>

  <!-- 真实 Schema2 Host creation regression：引用生产主程序集（连同 FerriteLib.UiKit 与
       Krafs.Rimworld.Ref 编译期引用）。运行时用 FerriteLib 仓库里的最小可执行桩程序集替换
       Verse/Unity，Host 创建/测量/绘制路径因此可在本地无游戏环境执行。
       说明：本项目刻意使用“先构建生产 DLL + 直接 Reference”而不是 ProjectReference。本机
       dotnet SDK 10 在嵌套 MSBuild 解析 UniversalSqueaker.csproj 的 SDK workload locator 时
       会静默失败（MSB4276），但直接构建生产项目成功；直接引用保持“使用真实生产代码”且可在
       no-restore 的 focused harness 中稳定复现。 -->
  <Target Name="BuildProductionAssemblies" BeforeTargets="ResolveReferences" Condition="'$(UsProductAlreadyBuilt)' != 'true'">
    <Exec Command="dotnet build &quot;..\..\Source\UniversalSqueaker\UniversalSqueaker.csproj&quot; -c $(Configuration) &quot;-p:FerriteLibArtifactPath=$(FerriteLibArtifactFullPath)&quot; $(UsRestoreArgument) --nologo -v quiet"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup>
    <!-- Root fixtures using fc010bd's removed private hooks are retained, not counted as current
         coverage. Current/ migrates the affected capabilities through public Execution; DbEat/DC
         Select retain their original assertions. See docs/fl08-consumer-migration-zh.md for limits. -->
    <Compile Remove="*.cs" />
    <Compile Include="RecordingSettingsSource.cs;RecordingOverlaySource.cs;DbEatUiTests.cs;DcSelectUiTests.cs;DiagnosticsPanelLaneTests.cs;UsTripGuard.cs;Fl08PublicObservation.cs;V4RemainingLaneTests.cs" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <Reference Include="UniversalSqueaker">
      <HintPath>$(UsProductArtifactPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FerriteLib.UiKit">
      <!-- The carrier mod's payload, built in the sibling repo. Never copied into US's own
           1.6/Assemblies, which is what keeps a second carrier from entering the US package. -->
      <HintPath>$(FerriteLibArtifactFullPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Source provenance and the explicit double/native boundary: tools/FerriteLib08.Stubs/README.md. -->
  <!-- -m:1 on the nested stub builds is deliberate and belongs with the note above: on this local
       machine a nested \`dotnet build\` whose graph has ProjectReferences dies silently in the child
       MSBuild node transport (exit 1, zero warnings, zero errors, no output even at -v n) while the same
       command succeeds with -m:1. It reproduces on clean sibling-repo sources, so it is an environment
       limitation, not a stub defect; single-node keeps the nested build deterministic. -->
  <Target Name="BuildAndCopyRuntimeStubs" AfterTargets="Build">
    <!-- A quoted Windows argument ending in \ escapes its closing quote in the child argv.
         Preserve directory semantics with forward slashes, including an explicit caller override. -->
    <PropertyGroup>
      <StubOutputCommandPath>$([System.String]::Copy('$(FerriteLibStubOutputRoot)').Replace('\', '/'))</StubOutputCommandPath>
      <StubObjCommandPath>$([System.String]::Copy('$(FerriteLibStubObjRoot)').Replace('\', '/'))</StubObjCommandPath>
    </PropertyGroup>
    <!-- Verse references Core/IMGUI/TextRendering; InputLegacy references Core. These two roots
         cover the same five runtime doubles without re-entering every dependency graph five times. -->
    <Exec Command="dotnet build &quot;$(FerriteLibHarness)/Stubs/VerseStub/VerseStub.csproj&quot; -c $(Configuration) $(UsRestoreArgument) --disable-build-servers --nologo -v quiet -m:1 &quot;-p:FerriteLibStubOutputRoot=$(StubOutputCommandPath)&quot; &quot;-p:FerriteLibStubObjRoot=$(StubObjCommandPath)&quot;"
          WorkingDirectory="$(FerriteLibHarness)" />
    <Exec Command="dotnet build &quot;$(FerriteLibHarness)/Stubs/UnityEngineInputLegacyModuleStub/UnityEngineInputLegacyModuleStub.csproj&quot; -c $(Configuration) $(UsRestoreArgument) --disable-build-servers --nologo -v quiet -m:1 &quot;-p:FerriteLibStubOutputRoot=$(StubOutputCommandPath)&quot; &quot;-p:FerriteLibStubObjRoot=$(StubObjCommandPath)&quot;"
          WorkingDirectory="$(FerriteLibHarness)" />
    <ItemGroup>
      <RuntimeStub Include="$(FerriteLibStubOutputRoot)unityengine\UnityEngine.CoreModule.dll" />
      <RuntimeStub Include="$(FerriteLibStubOutputRoot)unityengine-input\UnityEngine.InputLegacyModule.dll" />
      <RuntimeStub Include="$(FerriteLibStubOutputRoot)unityengine-imgui\UnityEngine.IMGUIModule.dll" />
      <RuntimeStub Include="$(FerriteLibStubOutputRoot)unityengine-textrendering\UnityEngine.TextRenderingModule.dll" />
      <RuntimeStub Include="$(FerriteLibStubOutputRoot)verse\Assembly-CSharp.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeStub)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
