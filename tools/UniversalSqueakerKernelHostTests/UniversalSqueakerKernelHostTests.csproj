<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>UniversalSqueakerKernelHostTests</AssemblyName>
    <RootNamespace>UniversalSqueaker.KernelHostTests</RootNamespace>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>0.0.0+us-kernel-host</InformationalVersion>
    <!-- 本地离线环境：禁用 NuGet 漏洞审计，避免无网 NU1900 噪声。 -->
    <NuGetAudit>false</NuGetAudit>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- FROZEN DELIVERY (US-UI1/ESC1 round): the stub sources come from the accepted FL freeze
         d5af4d8 as a byte-verified SNAPSHOT under tools/FerriteLib.Stubs (gate 16 pins all five
         recorded sha256 values), and this project builds them IN THE SNAPSHOT so the harness runs
         against byte-identical doubles while NO US build ever writes into the carrier's canonical
         bin/stubs output (INTERACTION-EXECUTION-20261008.md: the consumer verifies in its own
         outputs; FL released the slot at the freeze). -p:FerriteLibHarness=<path> still overrides. -->
    <FerriteLibHarness Condition="'$(FerriteLibHarness)' == ''">$(MSBuildProjectDirectory)\..\FerriteLib.Stubs</FerriteLibHarness>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>$(DefineConstants);US_DEV</DefineConstants>
  </PropertyGroup>

  <!-- 真实 Schema2 Host creation regression：引用生产主程序集（连同 FerriteLib.UiKit 与
       Krafs.Rimworld.Ref 编译期引用）。运行时用 FerriteLib 仓库里的最小可执行桩程序集替换
       Verse/Unity，Host 创建/测量/绘制路径因此可在本地无游戏环境执行。
       说明：本项目刻意使用“先构建生产 DLL + 直接 Reference”而不是 ProjectReference。本机
       dotnet SDK 10 在嵌套 MSBuild 解析 UniversalSqueaker.csproj 的 SDK workload locator 时
       会静默失败（MSB4276），但直接构建生产项目成功；直接引用保持“使用真实生产代码”且可在
       no-restore 的 focused harness 中稳定复现。 -->
  <Target Name="BuildProductionAssemblies" BeforeTargets="ResolveReferences">
    <Exec Command="dotnet build &quot;..\..\Source\UniversalSqueaker\UniversalSqueaker.csproj&quot; -c $(Configuration) &quot;-p:FerriteLibArtifactPath=$(FerriteLibArtifactFullPath)&quot; --nologo -v quiet"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <Reference Include="UniversalSqueaker">
      <HintPath>..\..\dist\build\$(Configuration)\UniversalSqueaker.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FerriteLib.UiKit">
      <!-- The carrier mod's payload, built in the sibling repo. Never copied into US's own
           1.6/Assemblies, which is what keeps a second carrier from entering the US package. -->
      <HintPath>$(FerriteLibArtifactFullPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- The stub sources are FerriteLib's (single source of truth: a second copy is how the
       layout-vs-audit two-metrics defect happened). Under the frozen delivery the copy is not free:
       verify-local gate 16 hashes all five recorded stub source files against frozen-handoff.json
       before these builds run, so the snapshot IS the carrier's bytes and the sibling repo's canonical
       bin/stubs output is never a US build target. -->
  <!-- -m:1 on the nested stub builds is deliberate and belongs with the note above: on this local
       machine a nested \`dotnet build\` whose graph has ProjectReferences dies silently in the child
       MSBuild node transport (exit 1, zero warnings, zero errors, no output even at -v n) while the same
       command succeeds with -m:1. It reproduces on clean sibling-repo sources, so it is an environment
       limitation, not a stub defect; single-node keeps the nested build deterministic. -->
  <Target Name="BuildAndCopyRuntimeStubs" AfterTargets="Build">
    <Exec Command="dotnet build &quot;$(FerriteLibHarness)\Stubs\UnityEngineStub\UnityEngineStub.csproj&quot; -c $(Configuration) --nologo -v quiet -m:1"
          WorkingDirectory="$(FerriteLibHarness)" />
    <Exec Command="dotnet build &quot;$(FerriteLibHarness)\Stubs\UnityEngineImGuiStub\UnityEngineImGuiStub.csproj&quot; -c $(Configuration) --nologo -v quiet -m:1"
          WorkingDirectory="$(FerriteLibHarness)" />
    <Exec Command="dotnet build &quot;$(FerriteLibHarness)\Stubs\UnityEngineTextRenderingModuleStub\UnityEngineTextRenderingModuleStub.csproj&quot; -c $(Configuration) --nologo -v quiet -m:1"
          WorkingDirectory="$(FerriteLibHarness)" />
    <Exec Command="dotnet build &quot;$(FerriteLibHarness)\Stubs\VerseStub\VerseStub.csproj&quot; -c $(Configuration) --nologo -v quiet -m:1"
          WorkingDirectory="$(FerriteLibHarness)" />
    <ItemGroup>
      <RuntimeStub Include="$(FerriteLibHarness)\bin\stubs\unityengine\UnityEngine.CoreModule.dll" />
      <RuntimeStub Include="$(FerriteLibHarness)\bin\stubs\unityengine-imgui\UnityEngine.IMGUIModule.dll" />
      <RuntimeStub Include="$(FerriteLibHarness)\bin\stubs\unityengine-textrendering\UnityEngine.TextRenderingModule.dll" />
      <RuntimeStub Include="$(FerriteLibHarness)\bin\stubs\verse\Assembly-CSharp.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeStub)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
